<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Joaquin Bonilla" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= @profile&.description || "Joaquin Bonilla — Backend Developer specializing in Java, Go, and cloud architecture." %>">
    <meta name="theme-color" content="#000d16">
    <meta name="color-scheme" content="dark">

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/cat-favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/cat-favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/cat-favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/cat-favicon-180.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Self-hosted faces. asset_path resolves through every Propshaft load
        path root, so these stay correct under digests (unlike CSS-relative
        URLs, which can't cross load path roots). %>
    <link rel="preload" as="font" type="font/woff2" crossorigin href="<%= asset_path("Geist-Regular.woff2") %>">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="<%= asset_path("GeistMono-Regular.woff2") %>">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="<%= asset_path("InstrumentSerif-Regular.woff2") %>">
    <style>
      @font-face {
        font-family: "Geist Sans";
        src: url("<%= asset_path("Geist-Regular.woff2") %>") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Geist Mono";
        src: url("<%= asset_path("GeistMono-Regular.woff2") %>") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Instrument Serif";
        src: url("<%= asset_path("InstrumentSerif-Regular.woff2") %>") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
    </style>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="cursor-glow" data-controller="cursor-glow" aria-hidden="true"></div>
    <%= render "shared/nav" %>
    <%= yield %>
    <script>
      // Arm scroll-reveal before first paint would flash the final layout.
      // Gated on the motion preference; without JS nothing is ever hidden.
      try {
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
          document.documentElement.setAttribute("data-motion", "");
      } catch (e) {}
    </script>
  </body>
</html>
